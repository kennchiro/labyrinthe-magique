[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

; Obligatoire pour exporter vers iOS et Android : sans elle, l'export échoue en
; silence (Godot invalide le préréglage sans écrire de message d'erreur).
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.043, 0.055, 0.078, 1)
textures/canvas_textures/default_texture_filter=1
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
